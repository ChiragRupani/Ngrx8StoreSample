{
  "name": "todoapp",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch --browsers=EdgeAnyHeadless",
    "lint": "ng lint",
    "migrate-cli": "ng update @angular/cli --from 21 --to 22 --migrate-only --allow-dirty",
    "migrate-core": "ng update @angular/core --from 21 --to 22 --migrate-only --allow-dirty",
    "signals": "ng generate @angular/core:signals"
  },
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@angular/router": "^22.1.4",
    "@ngrx/effects": "^22.0.0",
    "@ngrx/store": "^22.0.0",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.4",
    "@chiragrupani/karma-chromium-edge-launcher": "^2.5.1",
    "@types/jasmine": "~6.0.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~7.0.2",
    "jasmine-marbles": "^0.9.2",
    "karma": "~6.4.4",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "karma-jasmine": {
      "jasmine-core": "^6.3.0"
    },
    "qs": "^6.16.0",
    "vite": "npm:vite@latest",
    "vitest": "npm:vitest@latest"
  }
}
